# FreshMart Frontend — Environment Variables
# Copy to .env.local for local development

# Backend service URLs
# These point to the K8s ClusterIP services in the cluster.
# In local dev (Kind), use kubectl port-forward or the service NodePort.
# In production (EKS), these are internal DNS names.

NEXT_PUBLIC_PRODUCT_SERVICE_URL=http://product-service.tesco-core.svc.cluster.local:8001
NEXT_PUBLIC_CART_SERVICE_URL=http://cart-service.tesco-core.svc.cluster.local:8002
NEXT_PUBLIC_ORDER_SERVICE_URL=http://order-service.tesco-core.svc.cluster.local:8003

# Leave blank to use mock data (no backend needed for UI development)
# NEXT_PUBLIC_PRODUCT_SERVICE_URL=
# NEXT_PUBLIC_CART_SERVICE_URL=
# NEXT_PUBLIC_ORDER_SERVICE_URL=
